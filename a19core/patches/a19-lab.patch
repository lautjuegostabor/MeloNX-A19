+}
+
+private nonisolated enum A19Hardware {
+    static func cpuBench() -> [String: Double] {
+        let names = ["latency_ns_16KiB", "latency_ns_64KiB", "latency_ns_256KiB", "latency_ns_1MiB", "latency_ns_4MiB", "latency_ns_8MiB", "latency_ns_16MiB", "latency_ns_32MiB", "memcpy_GBps_1MiB", "memcpy_GBps_32MiB", "atomic_relaxed_ns_single_thread"]
+        var values = [Double](repeating: -1, count: names.count)
+        let count = values.withUnsafeMutableBufferPointer { a19CpuBench($0.baseAddress!, Int32($0.count)) }
+        guard count == Int32(names.count) else { return [:] }
+        return Dictionary(uniqueKeysWithValues: zip(names, values).filter { $0.1.isFinite && $0.1 >= 0 })
+    }
+    static func gpuBench() -> [String: Double] {
+        guard let device = MTLCreateSystemDefaultDevice(), let queue = device.makeCommandQueue() else { return [:] }
+        let source = """
+        #include <metal_stdlib>
+        using namespace metal;
+        kernel void f32(device float *out [[buffer(0)]], uint id [[thread_position_in_grid]]) {
+            float4 a = float4(float(id & 255u)*0.0001f+0.1f,0.2f,0.3f,0.4f);
+            float4 b = a+0.2f, c = a+0.3f, d = a+0.4f;
+            for(uint i=0;i<256;i++) { a=fma(a,float4(0.999f),float4(0.0001f)); b=fma(b,float4(0.998f),float4(0.0002f)); c=fma(c,float4(0.997f),float4(0.0003f)); d=fma(d,float4(0.996f),float4(0.0004f)); }
+            out[id]=dot(a+b+c+d,float4(1));
+        }
+        kernel void f16(device float *out [[buffer(0)]], uint id [[thread_position_in_grid]]) {
+            half4 a = half4(half(float(id & 255u)*0.0001f+0.1f),half(0.2f),half(0.3f),half(0.4f));
+            half4 b=a+half(0.2f), c=a+half(0.3f), d=a+half(0.4f);
+            for(uint i=0;i<256;i++) { a=fma(a,half4(0.999h),half4(0.0001h)); b=fma(b,half4(0.998h),half4(0.0002h)); c=fma(c,half4(0.997h),half4(0.0003h)); d=fma(d,half4(0.996h),half4(0.0004h)); }
+            out[id]=dot(float4(a+b+c+d),float4(1));
+        }
+        """
+        let options = MTLCompileOptions()
+        options.fastMathEnabled = false
+        guard let library = try? device.makeLibrary(source: source, options: options) else { return [:] }
+        let n = 65536
+        guard let output = device.makeBuffer(length: n*MemoryLayout<Float>.stride, options: .storageModeShared) else { return [:] }
+        var results: [String: Double] = [:]
+        for name in ["f32", "f16"] {
+            guard let function = library.makeFunction(name: name), let pipeline = try? device.makeComputePipelineState(function: function) else { continue }
+            var times: [Double] = []
+            for iteration in 0..<4 {
+                guard let command = queue.makeCommandBuffer(), let encoder = command.makeComputeCommandEncoder() else { break }
+                encoder.setComputePipelineState(pipeline)
+                encoder.setBuffer(output, offset: 0, index: 0)
+                let width = max(1, min(pipeline.maxTotalThreadsPerThreadgroup, pipeline.threadExecutionWidth*4))
+                encoder.dispatchThreads(MTLSize(width: n, height: 1, depth: 1), threadsPerThreadgroup: MTLSize(width: width, height: 1, depth: 1))
+                encoder.endEncoding(); command.commit(); command.waitUntilCompleted()
+                guard command.status == .completed, command.gpuEndTime > command.gpuStartTime else { continue }
+                let value = output.contents().assumingMemoryBound(to: Float.self)[n-1]
+                guard value.isFinite && value > 0 else { continue }
+                if iteration > 0 { times.append((command.gpuEndTime-command.gpuStartTime)*1000) }
+            }
+            if !times.isEmpty { results["metal_\(name)_median_ms"] = times.sorted()[times.count/2] }
+        }
+        return results
+    }
+}
