+@_silgen_name("a19_probe_options") private func a19Options(_ argumentBuffers: Int32, _ commandLimit: Int32, _ shaderWorkers: Int32, _ jitPadCalls: Int32)
+@_silgen_name("a19_probe_frequency") private func a19Frequency() -> Int64
