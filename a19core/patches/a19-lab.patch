+using System;
+using System.Diagnostics;
+using System.Threading;
+
+namespace Ryujinx.Common
+{
+    // Cumulative counters; snapshots are deliberately non-blocking and approximate across threads.
+    public static class A19Probe
+    {
+        public const int Count = 44;
+        private static readonly long[] Values = new long[Count];
+        private static int _enabled, _argumentBuffers, _commandLimit, _shaderWorkers, _jitPadCalls;
+        public static bool Enabled => Volatile.Read(ref _enabled) != 0;
+        public static int ArgumentBuffers => Volatile.Read(ref _argumentBuffers);
+        public static int CommandLimit => Volatile.Read(ref _commandLimit);
+        public static int ShaderWorkers => Volatile.Read(ref _shaderWorkers);
+        public static int JitPadCalls => Volatile.Read(ref _jitPadCalls);
+        public static void Enable(int enabled) => Volatile.Write(ref _enabled, enabled);
+        public static void Options(int arg, int limit, int workers, int padCalls)
+        {
+            Volatile.Write(ref _argumentBuffers, arg is 1 or 2 ? arg : 0);
+            Volatile.Write(ref _commandLimit, limit is 32 or 64 or 128 ? limit : 0);
+            Volatile.Write(ref _shaderWorkers, workers is 1 or 2 ? workers : 0);
+            Volatile.Write(ref _jitPadCalls, padCalls is 4 or 8 or 16 ? padCalls : 0);
+        }
+        public static long Start() => Enabled ? Stopwatch.GetTimestamp() : 0;
+        public static void Add(int index, long amount = 1)
+        {
+            if (Enabled) Interlocked.Add(ref Values[index], amount);
+        }
+        public static void Set(int index, long value) => Interlocked.Exchange(ref Values[index], value);
+        public static void End(long start, int count, int ticks)
+        {
+            if (start == 0 || !Enabled) return;
+            Interlocked.Increment(ref Values[count]);
+            Interlocked.Add(ref Values[ticks], Stopwatch.GetTimestamp() - start);
+        }
+        public static void Frame(double seconds)
+        {
+            if (!Enabled || seconds <= 0 || seconds > 10) return;
+            long us = (long)(seconds * 1_000_000);
+            Interlocked.Increment(ref Values[0]);
+            Interlocked.Add(ref Values[1], us);
+            int bucket = us <= 8334 ? 2 : us <= 16667 ? 3 : us <= 33334 ? 4 : us <= 50000 ? 5 : us <= 100000 ? 6 : 7;
+            Interlocked.Increment(ref Values[bucket]);
+        }
+        public static long Read(int index) => Interlocked.Read(ref Values[index]);
+    }
+}
