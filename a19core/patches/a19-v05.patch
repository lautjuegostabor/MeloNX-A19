index 5487ef0..95f89b3 100644
--- a/src/MeloNX/MeloNX/Common/A19Bench.c
+++ b/src/MeloNX/MeloNX/Common/A19Bench.c
@@ -75,3 +75,75 @@ uint64_t a19_available_memory(void) {
     return 0;
 #endif
 }
+
+// Independent crash-resilient trace. All counters are cumulative except the documented gauges.
+#include <stdio.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <inttypes.h>
+#ifdef __APPLE__
+#include <mach/mach.h>
+#endif
+extern int32_t a19_probe_read(int64_t *, int32_t);
+extern int64_t a19_probe_frequency(void);
+static pthread_t trace_thread;
+static int trace_joinable; // start/stop called only from Swift main actor
+static _Atomic int trace_running, trace_count, trace_error;
+static FILE *trace_file;
+static uint64_t trace_footprint(void) {
+#ifdef __APPLE__
+    task_vm_info_data_t info;
+    mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&info, &count) == KERN_SUCCESS)
+        return info.phys_footprint;
+#endif
+    return 0;
+}
+static int trace_flush(FILE *f) { return fflush(f) == 0 && fsync(fileno(f)) == 0; }
+static void *trace_worker(void *unused) {
+    (void)unused;
+    FILE *f = trace_file;
+    const double start = ns();
+    double previous = start, previousWrite = 0;
+    int sequence = 0;
+    while (atomic_load(&trace_running) && sequence <= 600) {
+        int64_t values[61];
+        double now = ns();
+        if (a19_probe_read(values, 61) != 61) { atomic_store(&trace_error, 2); break; }
+        int64_t cpu = a19_cpu_time_us();
+        uint64_t footprint = trace_footprint(), available = a19_available_memory();
+        fprintf(f, "{\"type\":\"sample\",\"seq\":%d,\"elapsedSeconds\":%.6f,\"intervalSeconds\":%.6f,\"processCPUTimeUs\":%" PRId64 ",\"footprintBytes\":%" PRIu64 ",\"availableProcessBytes\":%" PRIu64 ",\"previousWriteMs\":%.3f,\"counters\":[", sequence, (now-start)/1e9, (now-previous)/1e9, cpu, footprint, available, previousWrite);
+        for (int i = 0; i < 61; i++) fprintf(f, "%s%" PRId64, i ? "," : "", values[i]);
+        fputs("]}\n", f);
+        if (ferror(f) || !trace_flush(f)) { atomic_store(&trace_error, 3); break; }
+        previousWrite = (ns()-now)/1e6;
+        previous = now;
+        atomic_store(&trace_count, ++sequence);
+        // Poll stop every 100ms; normal sample cadence approximately one second.
+        for (int i=0; i<10 && atomic_load(&trace_running); i++) {
+            struct timespec delay = {0, 100000000}; nanosleep(&delay, NULL);
+        }
+    }
+    fclose(f);
+    atomic_store(&trace_running, 0);
+    return NULL;
+}
+void a19_trace_stop(void) {
+    atomic_store(&trace_running, 0);
+    if (trace_joinable) { pthread_join(trace_thread, NULL); trace_joinable = 0; }
+}
+int32_t a19_trace_start(const char *path) {
+    a19_trace_stop();
+    atomic_store(&trace_count, 0); atomic_store(&trace_error, 0);
+    trace_file = fopen(path, "w");
+    if (!trace_file) return 0;
+    fprintf(trace_file, "{\"type\":\"header\",\"schemaVersion\":2,\"build\":\"A19 Lab 0.5\",\"stopwatchFrequency\":%" PRId64 ",\"counterMode\":\"cumulative except gauges 29-35 and 44-60\",\"counterNames\":[\"frames\",\"frame_interval_us\",\"frame_le_8_334ms\",\"frame_8_334_to_16_667ms\",\"frame_16_667_to_33_334ms\",\"frame_33_334_to_50ms\",\"frame_50_to_100ms\",\"frame_gt_100ms\",\"jit_compiles\",\"jit_compile_ticks\",\"jit_host_code_bytes\",\"jit_guest_code_bytes\",\"jit_shared_copy_bytes\",\"jit_local_copy_bytes\",\"jit_local_page_bytes\",\"jit_pad_calls\",\"jit_pad_ticks\",\"jit_local_icache_calls\",\"jit_local_icache_ticks\",\"fence_wait_calls\",\"fence_wait_ticks\",\"queue_submit_calls\",\"queue_submit_ticks\",\"pipeline_create_calls\",\"pipeline_create_ticks\",\"mapped_upload_bytes\",\"mirror_upload_bytes\",\"background_compile_jobs\",\"background_compile_ticks\",\"mvk_get_result\",\"mvk_set_result\",\"mvk_readback_result\",\"mvk_argument_buffers_readback\",\"mvk_command_limit_readback\",\"mvk_config_struct_bytes\",\"shader_workers\",\"fifo_intervals\",\"fifo_active_us\",\"host_present_calls\",\"host_present_ticks\",\"allocation_requests\",\"allocation_requested_bytes\",\"allocation_request_ticks\",\"staging_or_inline_fallback_requested_bytes\",\"mvk_statistics_result\",\"mvk_spirv_to_msl_count\",\"mvk_spirv_to_msl_avg_us\",\"mvk_msl_compile_count\",\"mvk_msl_compile_avg_us\",\"mvk_shader_cache_count\",\"mvk_shader_cache_avg_us\",\"mvk_pipeline_compile_count\",\"mvk_pipeline_compile_avg_us\",\"mvk_retrieve_command_count\",\"mvk_retrieve_command_avg_us\",\"mvk_encode_command_count\",\"mvk_encode_command_avg_us\",\"mvk_execute_command_count\",\"mvk_execute_command_avg_us\",\"mvk_gpu_memory_count\",\"mvk_gpu_memory_avg_kib_x1000\"]}\n", a19_probe_frequency());
+    if (!trace_flush(trace_file)) { fclose(trace_file); return 0; }
+    atomic_store(&trace_running, 1);
+    if (pthread_create(&trace_thread, NULL, trace_worker, NULL) != 0) {
+        atomic_store(&trace_running, 0); fclose(trace_file); return 0;
+    }
+    trace_joinable = 1; return 1;
+}
+int32_t a19_trace_count(void) { return atomic_load(&trace_count); }
+int32_t a19_trace_error(void) { return atomic_load(&trace_error); }
