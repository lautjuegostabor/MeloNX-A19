+        // v1.4.0 has 24 consecutive trackers, each 48 bytes on arm64.
+        // Reject different private API layouts rather than interpreting an incompatible buffer.
+        [StructLayout(LayoutKind.Sequential)]
+        private struct Tracker
+        {
+            public uint Count;
+            public double Latest, Previous, Average, Minimum, Maximum;
+        }
+
+        [LibraryImport("libMoltenVK.dylib")]
+        private static unsafe partial Result vkGetPerformanceStatisticsMVK(nint device, Tracker* statistics, ref nint size);
+
+        private static bool _statsUnavailable;
+
+        public static unsafe void SamplePerformance(Device device)
+        {
+            if (!OperatingSystem.IsIOS() || !A19Probe.Enabled || _statsUnavailable) return;
+            const int trackerCount = 24;
+            nint expected = trackerCount * sizeof(Tracker);
+            if (sizeof(Tracker) != 48) { A19Probe.Set(44, -100); _statsUnavailable = true; return; }
+            try
+            {
+                nint size = 0;
+                Result query = vkGetPerformanceStatisticsMVK(device.Handle, null, ref size);
+                if (size != expected || (query != Result.Success && query != Result.Incomplete))
+                {
+                    A19Probe.Set(44, -101); _statsUnavailable = true; return;
+                }
+                Tracker* stats = stackalloc Tracker[trackerCount];
+                Result result = vkGetPerformanceStatisticsMVK(device.Handle, stats, ref size);
+                A19Probe.Set(44, (int)result);
+                if (result != Result.Success || size != expected) return;
+                // Counts and averages are device-lifetime gauges, not interval deltas.
+                ReadTracker(stats[1], 45);  // SPIR-V to MSL
+                ReadTracker(stats[2], 47);  // MSL compilation
+                ReadTracker(stats[6], 49);  // shader library cache
+                ReadTracker(stats[9], 51);  // pipeline compilation
+                ReadTracker(stats[14], 53); // retrieve command buffer
+                ReadTracker(stats[15], 55); // command buffer encoding
+                ReadTracker(stats[18], 57); // commit to completion
+                ReadTracker(stats[23], 59); // GPU allocated memory (KiB)
+            }
+            catch (EntryPointNotFoundException) { A19Probe.Set(44, -102); _statsUnavailable = true; }
+            catch (DllNotFoundException) { A19Probe.Set(44, -103); _statsUnavailable = true; }
+        }
+
+        private static void ReadTracker(Tracker tracker, int index)
+        {
+            A19Probe.Set(index, tracker.Count);
+            double scaled = tracker.Average * 1000.0;
+            A19Probe.Set(index + 1, double.IsFinite(scaled) && scaled >= 0 && scaled < long.MaxValue ? (long)scaled : -1);
+        }
+
+        private static bool Readable(Result result, nint size, int expected)
+        {
+            return (result == Result.Success || result == Result.Incomplete) && size.ToInt64() >= expected;
+        }
