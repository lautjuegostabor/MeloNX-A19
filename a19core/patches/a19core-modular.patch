+++ b/src/Ryujinx.Common/A19Trial.cs
@@ -0,0 +1,65 @@
+using System;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Threading;
+
+namespace Ryujinx.Common
+{
+    // Settings are applied once before a game creates its engine. No hot changes.
+    public static class A19Trial
+    {
+        public const int BufferLookup = 32;
+        public const int MappedGrowth = 64;
+        public const int UniformReuse = 128;
+        public const int ShaderSaveQueue = 256;
+        public const int IdleWait = 512;
+        public const int FenceFast = 1024;
+        public const int SchedulerAlloc = 2048;
+        public const int PoolBudget = 4096;
+        public const int TextureBudget = 8192;
+        public const int IsolatedPipelines = 16384;
+        public const int ThermalCompile = 32768;
+        public const int CommandReuse = 65536;
+        private static int _thermal;
+        private static long _available = -1, _sampleTime;
+        private static long _pooledBytes;
+        public static long PooledBytes => Interlocked.Read(ref _pooledBytes);
+        private const long PoolLimit = 32L * 1024 * 1024;
+        public static void SetThermal(int state) => Volatile.Write(ref _thermal, Math.Clamp(state, 0, 3));
+        public static int Thermal => Volatile.Read(ref _thermal);
+        [DllImport("/usr/lib/libSystem.B.dylib", EntryPoint = "os_proc_available_memory")]
+        private static extern nuint AvailableNative();
+        public static long AvailableBytes
+        {
+            get
+            {
+                if (!OperatingSystem.IsIOS()) return -1;
+                long now = Stopwatch.GetTimestamp();
+                long prev = Volatile.Read(ref _sampleTime);
+                if (prev == 0 || now - prev >= Stopwatch.Frequency)
+                {
+                    if (Interlocked.CompareExchange(ref _sampleTime, now, prev) == prev)
+                    {
+                        long available = -1;
+                        try { available = checked((long)AvailableNative()); }
+                        catch (EntryPointNotFoundException) { }
+                        catch (DllNotFoundException) { }
+                        Volatile.Write(ref _available, available);
+                    }
+                }
+                return Volatile.Read(ref _available);
+            }
+        }
+        public static bool TryReservePool(long bytes)
+        {
+            long current;
+            do
+            {
+                current = Interlocked.Read(ref _pooledBytes);
+                if (bytes < 0 || bytes > PoolLimit - current) return false;
+            } while (Interlocked.CompareExchange(ref _pooledBytes, current + bytes, current) != current);
+            return true;
+        }
+        public static void ReleasePool(long bytes) => Interlocked.Add(ref _pooledBytes, -bytes);
+    }
+}
